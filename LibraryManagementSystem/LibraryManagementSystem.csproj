<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\Brand\libraryforge.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.20"><PrivateAssets>all</PrivateAssets></PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.20" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Brand\libraryforge-primary-light.png" />
    <Resource Include="Resources\Brand\libraryforge-primary-dark.png" />
    <Resource Include="Resources\Brand\libraryforge-primary-mono.png" />
    <Resource Include="Resources\Brand\libraryforge-icon-light-1024.png" />
    <Resource Include="Resources\Brand\libraryforge-icon-dark-1024.png" />
    <Resource Include="Resources\Brand\libraryforge-icon-mono-1024.png" />
    <Resource Include="Resources\Brand\libraryforge-icon-512.png" />
    <Resource Include="Resources\Brand\libraryforge-icon-256.png" />
    <Resource Include="Resources\Brand\libraryforge-icon-128.png" />
    <Resource Include="Resources\Brand\libraryforge-icon-64.png" />
    <Resource Include="Resources\Brand\libraryforge-icon-32.png" />
    <Resource Include="Resources\Brand\libraryforge.ico" />
  </ItemGroup>

</Project>

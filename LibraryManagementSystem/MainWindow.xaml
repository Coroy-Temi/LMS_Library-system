<Window x:Class="LibraryManagementSystem.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
 Title="LibraryForge" Icon="pack://application:,,,/Resources/Brand/libraryforge.ico" Width="1280" Height="800" MinWidth="1050" MinHeight="650"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource MaterialDesign.Brush.Background}">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/></Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#0F172A">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition/><RowDefinition Height="126"/></Grid.RowDefinitions>
    <Grid Margin="18,12">
     <Image Source="pack://application:,,,/Resources/Brand/libraryforge-primary-dark.png" Width="220" Height="55" Stretch="Uniform" HorizontalAlignment="Left" AutomationProperties.Name="LibraryForge logo"/>
     <TextBlock Text="INTELLIGENT LIBRARY SYSTEM" Foreground="#94A3B8" FontSize="9" VerticalAlignment="Bottom" Margin="3,0,0,0"/>
    </Grid>
    <StackPanel Grid.Row="1">
     <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Visibility="{Binding IsStaff,Converter={StaticResource BoolToVisibility}}"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="ViewDashboardOutline" Margin="0,0,14,0"/><TextBlock Text="Dashboard"/></StackPanel></Button>
     <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="My Library" Visibility="{Binding HasMemberProfile,Converter={StaticResource BoolToVisibility}}"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="AccountCircleOutline" Margin="0,0,14,0"/><TextBlock Text="My Library"/></StackPanel></Button>
     <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Catalog" Visibility="{Binding IsViewer,Converter={StaticResource BoolToVisibility}}"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="Bookshelf" Margin="0,0,14,0"/><TextBlock Text="Browse Catalog"/></StackPanel></Button>
     <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Books" Visibility="{Binding CanManageCatalog,Converter={StaticResource BoolToVisibility}}"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="BookOpenPageVariantOutline" Margin="0,0,14,0"/><TextBlock Text="Books"/></StackPanel></Button>
     <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Members" Visibility="{Binding CanViewMembers,Converter={StaticResource BoolToVisibility}}"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="AccountGroupOutline" Margin="0,0,14,0"/><TextBlock Text="Members"/></StackPanel></Button>
     <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Loans" Visibility="{Binding CanManageCirculation,Converter={StaticResource BoolToVisibility}}"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="SwapHorizontal" Margin="0,0,14,0"/><TextBlock Text="Loans &amp; Returns"/></StackPanel></Button>
     <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Reservations" Visibility="{Binding CanManageReservations,Converter={StaticResource BoolToVisibility}}"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="BookClockOutline" Margin="0,0,14,0"/><TextBlock Text="Reservations"/></StackPanel></Button>
     <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Admin" Visibility="{Binding CanOpenAdmin,Converter={StaticResource BoolToVisibility}}"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="ShieldAccountOutline" Margin="0,0,14,0"/><TextBlock Text="Admin Panel"/></StackPanel></Button>
     <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="CogOutline" Margin="0,0,14,0"/><TextBlock Text="Settings"/></StackPanel></Button>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="20,12">
     <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding RoleName}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,8"/>
     <Button Content="Sign out" Command="{Binding LogoutCommand}" Foreground="#F4A261" HorizontalContentAlignment="Left" Background="Transparent" Padding="0,4"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition/></Grid.RowDefinitions>
   <Border Background="{DynamicResource MaterialDesign.Brush.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}" BorderThickness="0,0,0,1">
    <Grid Margin="28,0"><TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Command="{Binding ToggleThemeCommand}" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignIconButton}" ToolTip="Switch light/dark theme"><md:PackIcon Kind="ThemeLightDark" Width="24" Height="24"/></Button></Grid>
   </Border>
   <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="20"/>
  </Grid>
 </Grid>
</Window>

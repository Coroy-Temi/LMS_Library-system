{
  "ConnectionStrings": { "LibraryDatabase": "Data Source=Library.db" },
  "Library": { "FinePerDay": 0.50, "DefaultLoanDays": 14, "PageSize": 20 },
  "Security": { "MaxFailedLoginAttempts": 5, "LockoutMinutes": 15, "SessionHours": 8 },
  "GoogleOAuth": { "ClientId": "", "ClientSecret": "", "TimeoutSeconds": 180 },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "SenderEmail": "",
    "SenderName": "LibraryForge",
    "VerificationCodeMinutes": 10,
    "ResendDelaySeconds": 60,
    "MaximumVerificationAttempts": 5
  },
  "Serilog": { "MinimumLevel": "Information", "WriteTo": [ { "Name": "File", "Args": { "path": "logs/library-.log", "rollingInterval": "Day" } } ] }
}

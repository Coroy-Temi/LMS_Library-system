<Window x:Class="LibraryManagementSystem.Views.MemberEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
 Title="Member editor" Icon="pack://application:,,,/Resources/Brand/libraryforge.ico" Width="650" Height="650" WindowStartupLocation="CenterOwner" Background="{DynamicResource MaterialDesign.Brush.Background}">
 <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{Binding DialogTitle}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Membership identity and eligibility" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Secondary}" Margin="0,4,0,18"/></StackPanel>
  <ScrollViewer Grid.Row="1"><StackPanel Margin="0,4,8,4"><TextBox Text="{Binding Item.MemberCode}" IsReadOnly="True" md:HintAssist.Hint="Member code" Margin="0,5"/><TextBox Text="{Binding Item.FullName,UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="Full name *" Margin="0,5"/><TextBox Text="{Binding Item.Email,UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="Email *" Margin="0,5"/><TextBox Text="{Binding Item.Phone}" md:HintAssist.Hint="Phone" Margin="0,5"/><TextBox Text="{Binding Item.Address}" md:HintAssist.Hint="Address" Margin="0,5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><DatePicker SelectedDate="{Binding Item.JoinedAt}" md:HintAssist.Hint="Joined" Margin="0,5,8,5"/><DatePicker Grid.Column="1" SelectedDate="{Binding Item.ExpiresAt}" md:HintAssist.Hint="Membership expires" Margin="8,5,0,5"/></Grid><CheckBox IsChecked="{Binding Item.IsActive}" Content="Membership is active" Margin="0,14,0,4"/></StackPanel></ScrollViewer>
  <Grid Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="{Binding Message}" Foreground="#EF4444" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,240,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="CANCEL" IsCancel="True" Width="100"/><Button Content="SAVE MEMBER" Command="{Binding SaveCommand}" IsDefault="True" Width="135" Margin="10,0,0,0" Background="#006D77" Foreground="White"/></StackPanel></Grid>
 </Grid>
</Window>

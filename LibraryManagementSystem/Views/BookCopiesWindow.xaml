<Window x:Class="LibraryManagementSystem.Views.BookCopiesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" Title="Physical copies" Width="1080" Height="720" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{Binding BookTitle}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Each physical item has its own accession identity, condition history, circulation state, and installation-bound encrypted QR label." Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Secondary}" Margin="0,5,0,12"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><DataGrid ItemsSource="{Binding Copies}" SelectedItem="{Binding SelectedCopy}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="ACCESSION" Binding="{Binding AccessionCode}" Width="*"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="CONDITION" Binding="{Binding Condition}" Width="120"/><DataGridTextColumn Header="ACQUIRED" Binding="{Binding AcquiredAt,StringFormat={}{0:d}}" Width="120"/><DataGridTextColumn Header="QR ISSUED" Binding="{Binding LastQrIssuedAt,StringFormat={}{0:g}}" Width="160"/><DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="2*"/></DataGrid.Columns></DataGrid></Border>
  <Grid Grid.Row="2" Margin="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Notes,UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="Optional inventory note"/><WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="Add copy" Command="{Binding AddCopyCommand}" Background="#006D77" Foreground="White"/><Button Content="Maintenance" Command="{Binding MarkMaintenanceCommand}"/><Button Content="Lost" Command="{Binding MarkLostCommand}" Background="#EF4444" Foreground="White"/><Button Content="Restore" Command="{Binding RestoreCommand}"/><Button Content="Retire" Command="{Binding RetireCommand}"/><Button Content="Generate secure QR" Command="{Binding GenerateQrCommand}" Background="#F4A261" Foreground="#1F2937"/></WrapPanel></Grid>
  <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0"><DataGrid ItemsSource="{Binding History}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="WHEN" Binding="{Binding CreatedAt,StringFormat={}{0:g}}" Width="150"/><DataGridTextColumn Header="EVENT" Binding="{Binding EventType}" Width="140"/><DataGridTextColumn Header="STATUS FROM" Binding="{Binding FromStatus}" Width="110"/><DataGridTextColumn Header="STATUS TO" Binding="{Binding ToStatus}" Width="110"/><DataGridTextColumn Header="CONDITION" Binding="{Binding ToCondition}" Width="110"/><DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="*"/></DataGrid.Columns></DataGrid></Border>
  <Grid Grid.Row="4" Margin="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ScanText,UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="Scan or paste LF1 encrypted payload"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ValidateScanCommand}"/></TextBox.InputBindings></TextBox><Button Grid.Column="1" Content="Validate internally" Command="{Binding ValidateScanCommand}" Background="#006D77" Foreground="White"/><TextBlock Grid.ColumnSpan="2" Text="{Binding StatusMessage}" Margin="6,55,6,0" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Secondary}"/></Grid>
 </Grid>
</Window>

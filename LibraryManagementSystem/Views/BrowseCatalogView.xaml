<UserControl x:Class="LibraryManagementSystem.Views.BrowseCatalogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}" Margin="0,0,0,12"><Grid><TextBox Text="{Binding SearchTerm,UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="Search title, author, ISBN, or genre" Margin="0,0,130,0"/><Button Content="Search" Command="{Binding SearchCommand}" HorizontalAlignment="Right" Width="110" Background="#006D77" Foreground="White"/></Grid></Border>
  <Border Grid.Row="1" Style="{StaticResource Card}"><DataGrid ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}" IsReadOnly="True" AutoGenerateColumns="False" AutomationProperties.Name="Library catalog"><DataGrid.Columns><DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="AUTHOR" Binding="{Binding Author}" Width="*"/><DataGridTextColumn Header="GENRE" Binding="{Binding Genre.Name}" Width="*"/><DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="140"/><DataGridTextColumn Header="AVAILABLE" Binding="{Binding AvailableCopies}" Width="100"/><DataGridTextColumn Header="LOCATION" Binding="{Binding Location}" Width="120"/></DataGrid.Columns></DataGrid></Border>
  <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0"><Grid><TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,190,0" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Secondary}" AutomationProperties.LiveSetting="Polite"/><Button Content="RESERVE SELECTED" Command="{Binding ReserveSelectedCommand}" HorizontalAlignment="Right" Width="170" Height="44" Background="#F4A261" Foreground="#1F2937"/></Grid></Border>
 </Grid>
</UserControl>

<UserControl x:Class="LibraryManagementSystem.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"><ScrollViewer><StackPanel><TextBlock Text="Library at a glance" FontSize="16" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Secondary}" Margin="8,0,0,14"/><UniformGrid Columns="4"><Border Style="{StaticResource Card}"><StackPanel><md:PackIcon Kind="Bookshelf" Foreground="#006D77" Width="30" Height="30"/><TextBlock Text="{Binding TotalBooks}" FontSize="34" FontWeight="Bold" Margin="0,18,0,4"/><TextBlock Text="TOTAL COPIES" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Secondary}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><md:PackIcon Kind="BookCheckOutline" Foreground="#006D77" Width="30" Height="30"/><TextBlock Text="{Binding AvailableBooks}" FontSize="34" FontWeight="Bold" Margin="0,18,0,4"/><TextBlock Text="AVAILABLE" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Secondary}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><md:PackIcon Kind="AccountCheckOutline" Foreground="#006D77" Width="30" Height="30"/><TextBlock Text="{Binding ActiveMembers}" FontSize="34" FontWeight="Bold" Margin="0,18,0,4"/><TextBlock Text="ACTIVE MEMBERS" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Secondary}"/></StackPanel></Border><Border Style="{StaticResource Card}" BorderBrush="#F4A261" BorderThickness="2"><StackPanel><md:PackIcon Kind="AlertCircleOutline" Foreground="#F4A261" Width="30" Height="30"/><TextBlock Text="{Binding OverdueLoans}" FontSize="34" FontWeight="Bold" Margin="0,18,0,4"/><TextBlock Text="OVERDUE" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Secondary}"/></StackPanel></Border></UniformGrid><Border Style="{StaticResource Card}" Margin="8,20"><Grid><StackPanel><TextBlock Text="Welcome to Athena" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Use the navigation to manage inventory, members, loans, returns, and reports." Margin="0,10" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Secondary}"/></StackPanel><md:PackIcon Kind="BookEducationOutline" HorizontalAlignment="Right" Width="72" Height="72" Foreground="#33006D77"/></Grid></Border></StackPanel></ScrollViewer></UserControl>

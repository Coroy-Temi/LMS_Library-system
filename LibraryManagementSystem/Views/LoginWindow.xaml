<Window x:Class="LibraryManagementSystem.Views.LoginWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
 Title="Sign in to LibraryForge" Icon="pack://application:,,,/Resources/Brand/libraryforge.ico" Width="960" Height="660" ResizeMode="NoResize"
 WindowStartupLocation="CenterScreen" Background="#F8F9FA">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width=".9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
  <Border Background="#006D77">
   <Grid Margin="48"><StackPanel VerticalAlignment="Center"><Image Source="pack://application:,,,/Resources/Brand/libraryforge-primary-dark.png" Width="330" Height="96" Stretch="Uniform" HorizontalAlignment="Left" AutomationProperties.Name="LibraryForge logo"/><TextBlock Text="Knowledge, organized. A calm, modern workspace for your library team." FontSize="16" Foreground="#D5EEF0" TextWrapping="Wrap" Margin="0,28,0,0"/></StackPanel></Grid>
  </Border>
  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="70,0">
   <TextBlock Text="Welcome back" FontSize="30" FontWeight="SemiBold" Foreground="#212529"/>
   <TextBlock Text="Sign in to manage your library" Foreground="#64748B" Margin="0,8,0,28"/>
   <TextBox Text="{Binding Username,UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="Username" Margin="0,8" AutomationProperties.Name="Username"/>
   <PasswordBox x:Name="Password" md:HintAssist.Hint="Password" Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Margin="0,8" AutomationProperties.Name="Password"/>
   <TextBlock Text="{Binding ErrorMessage}" Foreground="#C2410C" Margin="0,8" TextWrapping="Wrap"/>
   <Button Content="SIGN IN" Command="{Binding LoginCommand}" Height="48" Margin="0,12,0,6" Style="{StaticResource MaterialDesignRaisedButton}" Background="#006D77" Foreground="White" IsDefault="True"/>
   <Button Command="{Binding GoogleLoginCommand}" Height="48" Margin="0,6" Background="White" Foreground="#1F2937" BorderBrush="#CBD5E1" BorderThickness="1"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="Google" Width="20" Height="20" Margin="0,0,10,0"/><TextBlock Text="Continue with Google" VerticalAlignment="Center"/></StackPanel></Button>
   <Button Content="CREATE MEMBER ACCOUNT" Command="{Binding RegisterCommand}" Height="44" Margin="0,6" Foreground="#006D77" Background="Transparent" BorderBrush="#006D77" BorderThickness="1"/>
   <TextBlock Text="Google sign-in opens securely in your default browser." HorizontalAlignment="Center" Foreground="#64748B" FontSize="10" Margin="0,6"/>
   <TextBlock Text="Staff demo: admin / admin123" HorizontalAlignment="Center" Foreground="#64748B" FontSize="11" Margin="0,8"/>
  </StackPanel>
 </Grid>
</Window>

<UserControl x:Class="LibraryManagementSystem.Views.MemberPortalView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
 <ScrollViewer>
  <StackPanel>
   <Grid Margin="8,0,8,18"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="58" Height="58" Stroke="#00A8B5" StrokeThickness="2"><Ellipse.Fill><ImageBrush ImageSource="{Binding ProfileImagePath}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding MemberName,StringFormat='Welcome back, {0}'}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding MemberCode,StringFormat='Member code: {0}'}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Secondary}" Margin="0,5"/></StackPanel><Button Grid.Column="2" Content="Refresh" Command="{Binding LoadCommand}" VerticalAlignment="Center"/></Grid>
   <UniformGrid Columns="3">
    <Border Style="{StaticResource Card}"><StackPanel><md:PackIcon Kind="BookClockOutline" Foreground="#006D77" Width="30" Height="30"/><TextBlock Text="{Binding ActiveLoanCount}" FontSize="32" FontWeight="Bold" Margin="0,14,0,2"/><TextBlock Text="BOOKS ON LOAN" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Secondary}"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><md:PackIcon Kind="BookmarkCheckOutline" Foreground="#F4A261" Width="30" Height="30"/><TextBlock Text="{Binding ReservationCount}" FontSize="32" FontWeight="Bold" Margin="0,14,0,2"/><TextBlock Text="ACTIVE RESERVATIONS" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Secondary}"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><md:PackIcon Kind="BookCheckOutline" Foreground="#10B981" Width="30" Height="30"/><TextBlock Text="{Binding BooksRead}" FontSize="32" FontWeight="Bold" Margin="0,14,0,2"/><TextBlock Text="BOOKS COMPLETED" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Secondary}"/></StackPanel></Border>
   </UniformGrid>
   <TextBlock Text="Currently borrowed" FontSize="19" FontWeight="SemiBold" Margin="8,22,8,8"/>
   <Border Style="{StaticResource Card}"><DataGrid ItemsSource="{Binding ActiveLoans}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="TITLE" Binding="{Binding Book.Title}" Width="2*"/><DataGridTextColumn Header="AUTHOR" Binding="{Binding Book.Author}" Width="*"/><DataGridTextColumn Header="ISSUED" Binding="{Binding IssuedAt,StringFormat=d}" Width="120"/><DataGridTextColumn Header="DUE" Binding="{Binding DueAt,StringFormat=d}" Width="120"/><DataGridCheckBoxColumn Header="OVERDUE" Binding="{Binding IsOverdue}" Width="90"/></DataGrid.Columns></DataGrid></Border>
   <TextBlock Text="Reservations" FontSize="19" FontWeight="SemiBold" Margin="8,22,8,8"/>
   <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Reservations}" SelectedItem="{Binding SelectedReservation}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="TITLE" Binding="{Binding Book.Title}" Width="2*"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*"/><DataGridTextColumn Header="QUEUE" Binding="{Binding QueuePosition}" Width="90"/><DataGridTextColumn Header="PICKUP BY" Binding="{Binding ExpiresAt,StringFormat=g}" Width="150"/></DataGrid.Columns></DataGrid><Grid Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,190,0" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Secondary}" AutomationProperties.LiveSetting="Polite"/><Button Content="CANCEL SELECTED" Command="{Binding CancelReservationCommand}" HorizontalAlignment="Right" Width="170" Background="#EF4444" Foreground="White"/></Grid></Grid></Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>

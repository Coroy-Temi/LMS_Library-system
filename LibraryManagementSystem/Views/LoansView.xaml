<UserControl x:Class="LibraryManagementSystem.Views.LoansView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding BookId}" md:HintAssist.Hint="Book ID"/><TextBox Grid.Column="1" Text="{Binding MemberId}" md:HintAssist.Hint="Member ID"/><TextBox Grid.Column="2" Text="{Binding LoanDays}" md:HintAssist.Hint="Loan days"/><Button Grid.Column="3" Content="Issue book" Command="{Binding IssueCommand}" Background="#006D77" Foreground="White" Margin="12,6"/></Grid></Border><Border Grid.Row="1" Style="{StaticResource Card}"><DataGrid ItemsSource="{Binding Loans}" SelectedItem="{Binding SelectedLoan}"><DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}"><Style.Triggers><DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="#F4A261"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="BOOK" Binding="{Binding Book.Title}" Width="2*"/><DataGridTextColumn Header="COPY" Binding="{Binding BookCopy.AccessionCode}" Width="140"/><DataGridTextColumn Header="MEMBER" Binding="{Binding Member.FullName}" Width="2*"/><DataGridTextColumn Header="ISSUED" Binding="{Binding IssuedAt,StringFormat=d}" Width="110"/><DataGridTextColumn Header="DUE" Binding="{Binding DueAt,StringFormat=d}" Width="110"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/></DataGrid.Columns></DataGrid></Border><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8"><Button Content="Export overdue PDF" Command="{Binding ExportOverdueCommand}"/><Button Content="Return selected" Command="{Binding ReturnCommand}" Background="#F4A261" Foreground="#212529" Margin="8,0"/></StackPanel></Grid></UserControl>

<UserControl x:Class="LibraryManagementSystem.Views.BooksView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="Search title, author, ISBN, or genre" Width="390" HorizontalAlignment="Left"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings></TextBox><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="4"/><Button Content="New book" Command="{Binding NewBookCommand}" Background="#006D77" Foreground="White" Margin="4"/><Button Content="Import CSV" Command="{Binding ImportCsvCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="4"/><Button Content="Export Excel" Command="{Binding ExportCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="4"/></StackPanel></Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}"><DataGrid ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="AUTHOR" Binding="{Binding Author}" Width="1.5*"/><DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="*"/><DataGridTextColumn Header="GENRE" Binding="{Binding Genre.Name}" Width="*"/><DataGridTextColumn Header="CONDITION" Binding="{Binding Condition}" Width="100"/><DataGridTextColumn Header="TOTAL" Binding="{Binding TotalCopies}" Width="80"/><DataGridTextColumn Header="AVAILABLE" Binding="{Binding AvailableCopies}" Width="100"/></DataGrid.Columns></DataGrid></Border>
  <Grid Grid.Row="2" Margin="8"><StackPanel Orientation="Horizontal"><Button Content="Previous" Command="{Binding PreviousCommand}"/><TextBlock Text="{Binding Page,StringFormat=Page {0}}" VerticalAlignment="Center" Margin="14"/><Button Content="Next" Command="{Binding NextCommand}"/><TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="18,0" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Secondary}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Manage copies &amp; QR" Command="{Binding ManageCopiesCommand}" Background="#F4A261" Foreground="#1F2937"/><Button Content="Edit selected" Command="{Binding EditBookCommand}" Background="#006D77" Foreground="White"/><Button Content="Delete" Command="{Binding DeleteCommand}" Margin="8,0,0,0" Background="#EF4444" Foreground="White"/></StackPanel></Grid>
 </Grid>
</UserControl>

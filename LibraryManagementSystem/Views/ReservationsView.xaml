<UserControl x:Class="LibraryManagementSystem.Views.ReservationsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox Text="{Binding BookId,UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="Book ID" AutomationProperties.Name="Book identifier"/>
    <TextBox Grid.Column="1" Text="{Binding MemberId,UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="Member ID" AutomationProperties.Name="Member identifier"/>
    <Button Grid.Column="2" Content="Add to waitlist" Command="{Binding ReserveCommand}" Background="#F4A261" Foreground="#1F2937" Margin="12,6" Padding="18,10"/>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="8,4">
   <TextBox Width="430" HorizontalAlignment="Left" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="Search book, member, or member code" AutomationProperties.Name="Search reservations">
    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
   </TextBox>
   <Button HorizontalAlignment="Right" Content="Refresh" Command="{Binding LoadCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource Card}">
   <DataGrid ItemsSource="{Binding Reservations}" SelectedItem="{Binding SelectedReservation}" AutomationProperties.Name="Active reservations">
    <DataGrid.RowStyle>
     <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
      <Style.Triggers>
       <DataTrigger Binding="{Binding Status}" Value="ReadyForPickup"><Setter Property="Foreground" Value="#F4A261"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
      </Style.Triggers>
     </Style>
    </DataGrid.RowStyle>
    <DataGrid.Columns>
     <DataGridTextColumn Header="BOOK" Binding="{Binding Book.Title}" Width="2*"/>
     <DataGridTextColumn Header="MEMBER" Binding="{Binding Member.FullName}" Width="1.5*"/>
     <DataGridTextColumn Header="MEMBER CODE" Binding="{Binding Member.MemberCode}" Width="120"/>
     <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="125"/>
     <DataGridTextColumn Header="QUEUE" Binding="{Binding QueuePosition}" Width="80"/>
     <DataGridTextColumn Header="RESERVED" Binding="{Binding ReservedAt,StringFormat=g}" Width="130"/>
     <DataGridTextColumn Header="PICKUP BY" Binding="{Binding ExpiresAt,StringFormat=g}" Width="130"/>
    </DataGrid.Columns>
   </DataGrid>
  </Border>
  <Grid Grid.Row="3" Margin="8">
   <TextBlock Text="Ready reservations protect available copies until their pickup deadline." Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Secondary}" VerticalAlignment="Center"/>
   <Button HorizontalAlignment="Right" Content="Cancel selected" Command="{Binding CancelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
  </Grid>
 </Grid>
</UserControl>

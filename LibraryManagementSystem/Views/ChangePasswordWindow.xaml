<Window x:Class="LibraryManagementSystem.Views.ChangePasswordWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
 Title="Change password" Icon="pack://application:,,,/Resources/Brand/libraryforge.ico" Width="520" Height="480" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource MaterialDesign.Brush.Background}">
 <Grid Margin="36">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Secure your account" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Choose a new password for LibraryForge." Foreground="#64748B" Margin="0,6,0,22"/></StackPanel>
  <StackPanel Grid.Row="1">
   <PasswordBox x:Name="CurrentPassword" md:HintAssist.Hint="Current password" Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Margin="0,7" AutomationProperties.Name="Current password"/>
   <PasswordBox x:Name="NewPassword" md:HintAssist.Hint="New password" Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Margin="0,7" AutomationProperties.Name="New password"/>
   <PasswordBox x:Name="Confirmation" md:HintAssist.Hint="Confirm new password" Style="{StaticResource MaterialDesignOutlinedPasswordBox}" Margin="0,7" AutomationProperties.Name="Confirm new password"/>
   <TextBlock Text="{Binding Message}" Foreground="#64748B" TextWrapping="Wrap" Margin="2,10"/>
  </StackPanel>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Cancel" IsCancel="True" Margin="6"/>
   <Button Content="Change password" Command="{Binding SaveCommand}" IsDefault="True" Background="#006D77" Foreground="White" Margin="6"/>
  </StackPanel>
 </Grid>
</Window>

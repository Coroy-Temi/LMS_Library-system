<Window x:Class="LibraryManagementSystem.Views.BookEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
 Title="Book editor" Icon="pack://application:,,,/Resources/Brand/libraryforge.ico" Width="760" Height="760" MinHeight="650" WindowStartupLocation="CenterOwner" Background="{DynamicResource MaterialDesign.Brush.Background}">
 <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{Binding DialogTitle}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Catalog metadata and physical inventory" Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Secondary}" Margin="0,4,0,14"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,4,8,4">
   <TextBox Text="{Binding Item.Title,UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="Title *" Margin="0,5"/><TextBox Text="{Binding Item.Author,UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="Author *" Margin="0,5"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding Item.Isbn,UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="ISBN" Margin="0,5,8,5"/><ComboBox Grid.Column="1" ItemsSource="{Binding Genres}" DisplayMemberPath="Name" SelectedValuePath="GenreId" SelectedValue="{Binding Item.GenreId}" md:HintAssist.Hint="Genre" Margin="8,5,0,5"/></Grid>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding Item.Publisher}" md:HintAssist.Hint="Publisher" Margin="0,5,8,5"/><TextBox Grid.Column="1" Text="{Binding Item.PublicationYear}" md:HintAssist.Hint="Publication year" Margin="8,5,0,5"/></Grid>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding Item.Location}" md:HintAssist.Hint="Shelf/location" Margin="0,5,8,5"/><ComboBox Grid.Column="1" ItemsSource="{Binding Conditions}" SelectedItem="{Binding Item.Condition}" md:HintAssist.Hint="Condition" Margin="8,5,0,5"/></Grid>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding Item.TotalCopies}" md:HintAssist.Hint="Total copies *" Margin="0,5,8,5"/><TextBox Grid.Column="1" Text="{Binding Item.AvailableCopies}" md:HintAssist.Hint="Available copies *" Margin="8,5,0,5"/></Grid>
   <TextBox Text="{Binding Item.CoverImagePath}" md:HintAssist.Hint="Cover image path" Margin="0,5"/><TextBox Text="{Binding Item.Description}" md:HintAssist.Hint="Description" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" VerticalContentAlignment="Top" Margin="0,5"/>
  </StackPanel></ScrollViewer>
  <Grid Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="{Binding Message}" Foreground="#EF4444" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,240,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="CANCEL" IsCancel="True" Width="100"/><Button Content="SAVE BOOK" Command="{Binding SaveCommand}" IsDefault="True" Width="125" Margin="10,0,0,0" Background="#006D77" Foreground="White"/></StackPanel></Grid>
 </Grid>
</Window>
